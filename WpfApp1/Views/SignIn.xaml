<Window x:Class="WpfApp1.Views.SignIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="SignIn" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Label Content="نام کاربری" HorizontalAlignment="Center"></Label>
            <TextBox Text="{Binding UserName }" x:Name="UserName" Width="100" Margin="5" HorizontalAlignment="Center"></TextBox>
            <Label Content="رمز عبور" HorizontalAlignment="Center"></Label>

            <PasswordBox x:Name="Password" Tag="وارد کردن پسورد" PasswordChanged="PasswordBox_PasswordChanged" Width="100" Margin="5" HorizontalAlignment="Center"></PasswordBox>
            <Button x:Name="Login" Content="ورود" Width="60" Height="30" Margin="0,200,0,10" HorizontalAlignment="Center" Command="{Binding LoginCommand }"></Button>
        </StackPanel>
        


    </Grid>
</Window>
